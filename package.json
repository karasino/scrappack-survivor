{
  "name": "scrappack-survivor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:combat-ui": "node tests/combat-ui.mjs",
    "test:visual": "node tests/combat-ui.mjs --visual-only",
    "test:exploration": "node tests/combat-ui.mjs --exploration-only",
    "test:crafting": "node tests/combat-ui.mjs --crafting-only",
    "doctor": "node scripts/doctor.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test:core": "node --import=tsx --test --test-timeout=15000 tests/core/inventory.test.mjs tests/core/energy-combat.test.mjs tests/core/exploration.test.mjs tests/core/crafting.test.mjs tests/core/run.test.mjs",
    "test:harness": "node --test --test-timeout=15000 tests/harness.test.mjs tests/scenario.test.mjs",
    "check": "node scripts/check.mjs",
    "scenario": "node scripts/scenario.mjs",
    "test:scenarios": "node tests/scenario-checks.mjs"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "engines": {
    "node": "24.x"
  }
}
